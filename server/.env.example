# Copie para `.env` (na RAIZ do repositório, não aqui) e preencha.
# O .env real não vai para o git — em produção, estes valores vão no painel
# do host (Render > Environment).

# Projeto no Supabase (Settings > API).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=

# Porta do Express. O Render injeta a dele; localmente cai em 3000.
PORT=3000

# Origem liberada no CORS. Em produção, a URL do front na Vercel
# (ex.: https://reprogrammed.vercel.app). Sem isso, libera geral com "*".
CLIENT_ORIGIN=http://localhost:5173
